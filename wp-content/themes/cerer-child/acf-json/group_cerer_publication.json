{
	"key": "group_cerer_publication",
	"title": "Publication",
	"fields": [
		{
			"key": "field_cerer_pub_type",
			"label": "Type",
			"name": "type",
			"type": "select",
			"choices": {
				"article": "Article scientifique",
				"rapport": "Rapport",
				"actes": "Actes de conférence",
				"these": "Thèse"
			},
			"default_value": "article",
			"return_format": "value",
			"allow_null": 0,
			"multiple": 0,
			"ui": 0
		},
		{
			"key": "field_cerer_pub_auteurs",
			"label": "Auteurs",
			"name": "auteurs",
			"type": "text",
			"instructions": "Séparés par des virgules.",
			"placeholder": "A. Diop, M. Fall"
		},
		{
			"key": "field_cerer_pub_type_auteur",
			"label": "Profil de l'auteur principal",
			"name": "type_auteur",
			"type": "select",
			"instructions": "Affiché en badge sur la fiche — qui publie doit être visible : chercheur du CERER, étudiant (mémoire, soutenance) ou auteur externe/partenaire.",
			"choices": {
				"chercheur": "Chercheur CERER",
				"etudiant": "Étudiant",
				"externe": "Auteur externe / partenaire"
			},
			"default_value": "chercheur",
			"return_format": "value",
			"allow_null": 0,
			"multiple": 0,
			"ui": 0
		},
		{
			"key": "field_cerer_pub_chercheur_lie",
			"label": "Fiche chercheur liée (optionnel)",
			"name": "chercheur_lie",
			"type": "post_object",
			"instructions": "Si l'auteur principal est un chercheur du CERER déjà référencé (CPT « Chercheurs »), le lier ici affiche sa photo et un lien vers sa fiche à la place du simple texte.",
			"post_type": [
				"chercheur"
			],
			"return_format": "id",
			"ui": 1,
			"allow_null": 1,
			"multiple": 0
		},
		{
			"key": "field_cerer_pub_revue",
			"label": "Revue",
			"name": "revue",
			"type": "text"
		},
		{
			"key": "field_cerer_pub_annee",
			"label": "Année",
			"name": "annee",
			"type": "number",
			"min": 1990,
			"max": 2100,
			"step": 1
		},
		{
			"key": "field_cerer_pub_resume",
			"label": "Résumé",
			"name": "resume",
			"type": "textarea",
			"rows": 4,
			"new_lines": "wpautop"
		},
		{
			"key": "field_cerer_pub_lien_pdf",
			"label": "Lien PDF",
			"name": "lien_pdf",
			"type": "url",
			"instructions": "URL externe uniquement (Drive, etc.) — aucun fichier n'est hébergé sur le serveur."
		},
		{
			"key": "field_cerer_pub_doi",
			"label": "DOI",
			"name": "doi",
			"type": "text",
			"placeholder": "10.xxxx/xxxxx"
		}
	],
	"location": [
		[
			{
				"param": "post_type",
				"operator": "==",
				"value": "publication"
			}
		]
	],
	"menu_order": 0,
	"position": "normal",
	"style": "default",
	"label_placement": "top",
	"instruction_placement": "label",
	"hide_on_screen": "",
	"active": true,
	"description": "",
	"show_in_rest": 1
}
